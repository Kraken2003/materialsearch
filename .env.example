# Local development works with COD, Materials Cloud, and Crossref without keys.
# Optional free accounts. Never prefix these with NEXT_PUBLIC_.
MP_API_KEY=
OPENALEX_API_KEY=
CONTACT_EMAIL=

# Public footer contact address. Set before building; visible to site visitors.
NEXT_PUBLIC_CONTACT_EMAIL=

# Required before public production search is enabled.
# Generate with: openssl rand -hex 32
CURSOR_SECRET=

# Set true only after checking your account's current public API-use terms.
# MP works locally with a key; public production use needs this confirmation too.
MP_PUBLIC_USE_CONFIRMED=true

# Per-instance caps on upstream cache misses, reset at midnight UTC.
COD_DAILY_LIMIT=300
MCLOUD_DAILY_LIMIT=300
MP_DAILY_LIMIT=200
CROSSREF_DAILY_LIMIT=400
OPENALEX_DAILY_LIMIT=50
PUBLIC_REQUESTS_PER_DAY=1000
CLIENT_REQUESTS_PER_MINUTE=12
